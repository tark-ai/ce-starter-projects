---
import type { Product } from "@commercengine/storefront";
import ProductContent from "../../components/product/ProductContent";
import Layout from "../../layouts/Layout.astro";
import { SITE_NAME, SITE_URL } from "../../lib/constants";
import { publicSdk } from "../../lib/storefront";

export async function getStaticPaths() {
  try {
    const { data } = await publicSdk.catalog.listProducts({ limit: 100 });
    return (data?.products ?? []).map((p) => ({
      params: { slug: p.slug || p.id },
    }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;

let product: Product | undefined;
try {
  const { data } = await publicSdk.catalog.getProductDetail({ product_id: slug! });
  product = data?.product;
} catch {
  product = undefined;
}

const siteUrl = import.meta.env.SITE || SITE_URL;

const productName = product?.name ?? "Product";
const productTitle = `${productName} | ${SITE_NAME}`;
const productDescription =
  product?.short_description || `Shop ${productName} from ${SITE_NAME}. The good stuff, minus the fluff.`;
const productImage =
  product?.images?.[0]?.url_zoom ||
  product?.images?.[0]?.url_standard ||
  product?.images?.[0]?.url_thumbnail ||
  "/og-image.jpg";

const jsonLd = product
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Product",
        name: product.name,
        description: product.short_description ?? `Shop ${product.name} from ${SITE_NAME}`,
        image: productImage.startsWith("http") ? productImage : `${siteUrl}${productImage}`,
        sku: product.sku ?? product.slug,
        url: `${siteUrl}/product/${slug}`,
        brand: { "@type": "Brand", name: SITE_NAME },
        offers: {
          "@type": "Offer",
          url: `${siteUrl}/product/${slug}`,
          priceCurrency: product.pricing.currency,
          price: product.pricing.selling_price,
          availability:
            product.stock_available || product.backorder
              ? "https://schema.org/InStock"
              : "https://schema.org/OutOfStock",
        },
        ...(product.reviews_count > 0
          ? {
              aggregateRating: {
                "@type": "AggregateRating",
                ratingValue: (product.reviews_rating_sum / product.reviews_count).toFixed(1),
                reviewCount: product.reviews_count,
              },
            }
          : {}),
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
          ...(product.categories?.[0]
            ? [
                {
                  "@type": "ListItem",
                  position: 2,
                  name: product.categories[0].name,
                  item: `${siteUrl}/category/${product.categories[0].slug}`,
                },
              ]
            : []),
          {
            "@type": "ListItem",
            position: product.categories?.[0] ? 3 : 2,
            name: product.name,
          },
        ],
      },
    ]
  : [];
---

<Layout
  title={productTitle}
  description={productDescription}
  image={productImage}
  ogType="product"
>
  {
    jsonLd.map((schema) => (
      <script
        is:inline
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    ))
  }
  <ProductContent client:idle serverProduct={product} />
</Layout>
