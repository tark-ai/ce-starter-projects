---
import TermsContent from "../../components/views/TermsContent";
import Layout from "../../layouts/Layout.astro";
import { SITE_NAME, SITE_URL } from "../../lib/constants";
---

<Layout
  title={`Terms of Service | ${SITE_NAME}`}
  description={`The terms that govern your use of the ${SITE_NAME} website and the purchase of our products.`}
  canonicalUrl={`${SITE_URL}/terms-of-service`}
>
  <TermsContent client:load />
</Layout>
