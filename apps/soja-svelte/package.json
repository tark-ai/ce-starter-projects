{
  "name": "@ce/soja-svelte",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8104",
    "build": "node scripts/check-env.mjs && node scripts/generate-seo-assets.mjs && vite build",
    "preview": "vite preview",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ce/soja-shared": "workspace:*",
    "@ce/soja-ui": "workspace:*",
    "@commercengine/ai": "^0.2.1",
    "@commercengine/checkout": "^0.3.1",
    "@commercengine/storefront": "^0.1.6",
    "@commercengine/seo": "^0.2.1",
    "@fontsource/average": "^5.3.0",
    "@fontsource/averia-serif-libre": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  }
}
