# Commerce Engine API credentials
# Get these from your Commerce Engine dashboard

# Vite apps (linea, linea-tanstack)
VITE_STORE_ID=your_store_id
VITE_API_KEY=your_api_key
VITE_CE_ENV=staging

# Next.js (linea-next)
NEXT_PUBLIC_STORE_ID=your_store_id
NEXT_PUBLIC_API_KEY=your_api_key
NEXT_PUBLIC_CE_ENV=staging

# Astro & SvelteKit (linea-astro, linea-svelte)
PUBLIC_STORE_ID=your_store_id
PUBLIC_API_KEY=your_api_key
PUBLIC_CE_ENV=staging
