{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".next/**", "!.next/cache/**", ".astro/**", ".svelte-kit/**", "build/**"],
      "inputs": [
        "src/**",
        "index.html",
        "vite.config.ts",
        "next.config.ts",
        "tsconfig.json",
        "tsconfig.app.json",
        "postcss.config.js",
        "postcss.config.mjs",
        "astro.config.mjs",
        "svelte.config.js"
      ],
      "env": ["VITE_STORE_ID", "VITE_API_KEY", "VITE_CE_ENV", "NEXT_PUBLIC_STORE_ID", "NEXT_PUBLIC_API_KEY", "NEXT_PUBLIC_CE_ENV", "PUBLIC_STORE_ID", "PUBLIC_API_KEY", "PUBLIC_CE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "check:fix": {
      "cache": false
    },
    "typecheck": {
      "outputs": []
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
