---
import type { ProductDetail } from "@commercengine/storefront";
import ProductContent from "../../components/product/ProductContent";
import { breadcrumbJsonLd } from "@commercengine/seo";
import { createAstroProductHead } from "@commercengine/seo/astro";
import Layout from "../../layouts/Layout.astro";
import { seo, site } from "../../lib/seo";
import { SITE_NAME } from "../../lib/constants";
import { publicSdk } from "../../lib/storefront";

export async function getStaticPaths() {
  const paths: Array<{ params: { slug: string } }> = [];
  try {
    // Paginate through the full catalog so every product gets a static route.
    // A single fixed page would 404 for products reachable via client-side
    // pagination/search once the catalog exceeds one page.
    let page = 1;
    const limit = 100;
    // Hard cap as a safety valve against an unexpected pagination loop.
    for (let guard = 0; guard < 200; guard++) {
      const { data, error } = await publicSdk.catalog.listProducts({ page, limit });
      if (error) {
        // API failure returned in-band (not thrown). Surface it on the same
        // diagnostic path as the catch and stop paginating so we don't silently
        // ship partial routes; the build stays green without live catalog creds.
        console.warn(
          "[little-things] Failed to list products for getStaticPaths; product routes may be missing.",
          error
        );
        break;
      }
      for (const p of data?.products ?? []) {
        paths.push({ params: { slug: p.slug || p.id } });
      }
      const nextPage = data?.pagination?.next_page;
      if (!nextPage || nextPage === page) break;
      page = nextPage;
    }
  } catch (error) {
    // Build stays green without live catalog access; pages render on request in dev.
    // Surface the outage so an empty/partial static build isn't silently shipped.
    console.warn(
      "[little-things] Failed to list products for getStaticPaths; product routes may be missing.",
      error
    );
  }
  return paths;
}

const { slug } = Astro.params;

let product: ProductDetail | undefined;
try {
  const { data } = await publicSdk.catalog.getProductDetail({ product_id: slug! });
  product = data?.product;
} catch (error) {
  product = undefined;
  console.warn(`[little-things] Failed to load product detail for "${slug}".`, error);
}

const productName = product?.name ?? "Product";
const productTitle = `${productName} | ${SITE_NAME}`;
const productDescription =
  product?.short_description || `Shop ${productName} from ${SITE_NAME}. The good stuff, minus the fluff.`;
const productImage =
  product?.images?.[0]?.url_zoom ||
  product?.images?.[0]?.url_standard ||
  product?.images?.[0]?.url_thumbnail ||
  "";

const seoHead = product ? await createAstroProductHead(seo, product) : undefined;

const breadcrumbCategory = product?.categories?.[0];
const [productUrl, categoryUrl] = product
  ? await Promise.all([
      seo.productUrl(product),
      breadcrumbCategory ? seo.categoryUrl(breadcrumbCategory) : Promise.resolve(null),
    ])
  : [null, null];
// `productHead` emits the product schema only; the breadcrumb stays the page's job. Resolve every
// entity through the same route contract so custom bases or CMS-owned URLs cannot diverge.
const breadcrumb = breadcrumbJsonLd([
  { name: "Home", url: site.url },
  ...(breadcrumbCategory?.name && categoryUrl
    ? [{ name: breadcrumbCategory.name, url: categoryUrl }]
    : []),
  { name: productName, url: productUrl ?? site.url },
]);

---

<Layout
  seoHead={seoHead}
  title={productTitle}
  description={productDescription}
  image={productImage}
  ogType="product"
  noindex={!product}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumb)}
  />
  <ProductContent client:idle serverProduct={product} />
</Layout>
