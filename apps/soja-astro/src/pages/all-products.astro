---
import type { Category, Item, Pagination } from "@commercengine/storefront";
import CategoryContent from "../components/views/CategoryContent";
import Layout from "../layouts/Layout.astro";
import { SITE_NAME } from "../lib/constants";
import { PLP_COPY } from "../lib/site-content";
import { publicSdk } from "../lib/storefront";

let skus: Item[] = [];
let pagination: Pagination | undefined;
let categories: Category[] = [];

// Settled, not all: a categories outage must not discard a successful product read.
const [skuResult, categoryResult] = await Promise.allSettled([
  publicSdk.catalog.searchProducts({ query: "", page: 1, limit: 12 }),
  publicSdk.catalog.listCategories(),
]);

if (skuResult.status === "fulfilled") {
  skus = skuResult.value.data?.skus ?? [];
  pagination = skuResult.value.data?.pagination;
} else {
  console.warn("[soja] All-products page shipped without products.", skuResult.reason);
}

if (categoryResult.status === "fulfilled") {
  categories = categoryResult.value.data?.categories ?? [];
} else {
  console.warn("[soja] All-products page shipped without categories.", categoryResult.reason);
}
---

<Layout
  title={`${PLP_COPY.title} | ${SITE_NAME}`}
  description={`Browse every formulation from ${SITE_NAME} in one place. ${PLP_COPY.subtitle}`}
>
  <CategoryContent
    client:load
    categories={categories}
    initialSkus={skus}
    initialPagination={pagination}
  />
</Layout>
