---
import type { Item, Pagination } from "@commercengine/storefront";
import CategoryContent from "../../components/views/CategoryContent";
import Layout from "../../layouts/Layout.astro";
import { buildFilter } from "../../lib/build-filter";
import { SITE_NAME, SITE_URL } from "../../lib/constants";
import { safeJsonLd } from "../../lib/json-ld";
import { PLP_COPY } from "../../lib/site-content";
import { publicSdk } from "../../lib/storefront";

export async function getStaticPaths() {
  try {
    const { data } = await publicSdk.catalog.listCategories();
    return (data?.categories ?? []).map((category) => ({
      params: { category: category.slug ?? category.id },
      props: { categoryData: category, categories: data?.categories ?? [] },
    }));
  } catch (error) {
    // Shipping a storefront with no category routes is worse than failing here.
    throw new Error(
      `[soja] Category discovery failed, so no category routes would be generated: ${error}`
    );
  }
}

const { category } = Astro.params;
const { categoryData, categories } = Astro.props;

const displayName =
  categoryData?.name ??
  (category ? category.charAt(0).toUpperCase() + category.slice(1) : PLP_COPY.title);
const description = categoryData?.description || PLP_COPY.subtitle;

let skus: Item[] = [];
let pagination: Pagination | undefined;
try {
  const filter = buildFilter({}, categoryData?.name);
  const { data } = await publicSdk.catalog.searchProducts({
    query: "",
    page: 1,
    limit: 12,
    ...(filter.length > 0 ? { filter } : {}),
  });
  skus = data?.skus ?? [];
  pagination = data?.pagination;
} catch (error) {
  console.warn(`[soja] Category "${category}" shipped without products.`, error);
}

const siteUrl = import.meta.env.SITE || SITE_URL;
const categoryUrl = `${siteUrl}/category/${category}`;

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: displayName,
  description,
  url: categoryUrl,
  ...(skus.length > 0
    ? {
        mainEntity: {
          "@type": "ItemList",
          itemListElement: skus.slice(0, 20).map((item, index) => ({
            "@type": "ListItem",
            position: index + 1,
            url: `${siteUrl}/product/${item.product_slug}`,
            name: item.product_name,
          })),
        },
      }
    : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: displayName, item: categoryUrl },
  ],
};
---

<Layout title={`${displayName} | ${SITE_NAME}`} description={description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={safeJsonLd(collectionSchema)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={safeJsonLd(breadcrumbSchema)}
  />
  <CategoryContent
    client:load
    categorySlug={category}
    categoryName={categoryData?.name}
    categoryDescription={categoryData?.description ?? undefined}
    categories={categories}
    initialSkus={skus}
    initialPagination={pagination}
  />
</Layout>
