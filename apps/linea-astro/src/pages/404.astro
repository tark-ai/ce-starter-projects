---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page Not Found | Linea" description="The page you were looking for could not be found.">
  <main class="pt-6 px-6">
    <div class="max-w-2xl mx-auto text-center py-24 lg:py-32">
      <p class="text-sm font-light text-muted-foreground mb-4">404</p>
      <h1 class="text-3xl md:text-4xl font-light text-foreground mb-4">
        Page not found
      </h1>
      <p class="text-sm font-light text-muted-foreground mb-10">
        The page you were looking for could not be found.
      </p>
      <a
        href="/"
        class="inline-block border border-foreground px-8 py-3 text-sm font-light text-foreground hover:bg-foreground hover:text-background transition-colors duration-200"
      >
        Return Home
      </a>
    </div>
  </main>
</Layout>
