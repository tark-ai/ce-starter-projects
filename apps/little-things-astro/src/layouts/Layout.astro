---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/globals.css";
import { PoweredByBadge } from "@ce/little-things-ui/components/ui/powered-by-badge";
import type { Category } from "@commercengine/storefront";
import Navigation from "../components/header/Navigation";
import Footer from "../components/footer/Footer";
import Toasts from "../components/Toasts";
import { SITE_NAME, SITE_URL } from "../lib/constants";
import { publicSdk } from "../lib/storefront";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title = `${SITE_NAME} | Everyday goods, minus the fluff`,
  description = `${SITE_NAME} is a tight, opinionated storefront for everyday goods worth owning.`,
  image = "",
  canonicalUrl,
  ogType = "website",
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.SITE || SITE_URL;
// Only emit an og:image when a real one exists (e.g. a product image). Avoid
// advertising a placeholder path that would 404.
const imageUrl = image ? (image.startsWith("http") ? image : `${siteUrl}${image}`) : "";
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;

let categories: Category[] = [];
try {
  const { data } = await publicSdk.catalog.listCategories();
  categories = data?.categories ?? [];
} catch {
  categories = [];
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content="@commerceengine" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div class="min-h-screen bg-background">
      <header class="w-full sticky top-0 z-50">
        <Navigation client:load serverCategories={categories} transition:persist />
      </header>
      <div data-page-content>
        <slot />
      </div>
      <Footer client:load transition:persist />
      <PoweredByBadge client:load transition:persist />
      <Toasts client:idle transition:persist />
    </div>

    <!-- App-level checkout bootstrapping + partial swap for the persistent shell -->
    <script>
      import { installLittleThingsClientRuntime } from "@/lib/client-runtime";

      installLittleThingsClientRuntime();
    </script>
  </body>
</html>
