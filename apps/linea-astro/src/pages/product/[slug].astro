---
import { breadcrumbJsonLd } from "@commercengine/seo";
import { createAstroProductHead } from "@commercengine/seo/astro";
import Layout from "../../layouts/Layout.astro";
import { seo, site } from "../../lib/seo";
import ProductContent from "../../components/product/ProductContent";
import { publicSdk } from "../../lib/storefront";

export async function getStaticPaths() {
  const { data } = await publicSdk.catalog.listProducts({ limit: 100 });
  return (data?.products ?? []).map((p) => ({
    params: { slug: p.slug || p.id },
  }));
}

const { slug } = Astro.params;

const [productResult, similarResult] = await Promise.all([
  publicSdk.catalog.getProductDetail({ product_id: slug! }),
  publicSdk.catalog.listSimilarProducts({ product_id: [slug!] }),
]);

const product = productResult.data?.product;
const similarItems = similarResult.data?.products ?? [];
const seoHead = product ? await createAstroProductHead(seo, product) : undefined;

const productName = product?.name ?? "Product";
const productTitle = `${productName} | LINEA`;
const productDescription =
  product?.short_description ||
  `Shop ${productName} from LINEA. Discover timeless elegance with our curated collection of fine jewelry.`;
const productImage =
  product?.images?.[0]?.url_standard ||
  product?.images?.[0]?.url_zoom ||
  product?.images?.[0]?.url_thumbnail ||
  "/og-image.jpg";

const category = product?.categories?.[0];
const [productUrl, categoryUrl] = product
  ? await Promise.all([
      seo.productUrl(product),
      category ? seo.categoryUrl(category) : Promise.resolve(null),
    ])
  : [null, null];
const breadcrumb = breadcrumbJsonLd([
  { name: "Home", url: site.url },
  ...(category?.name && categoryUrl ? [{ name: category.name, url: categoryUrl }] : []),
  { name: productName, url: productUrl ?? site.url },
]);

---

<Layout
  seoHead={seoHead}
  title={productTitle}
  description={productDescription}
  image={productImage}
  ogType="product"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumb)}
  />
  <ProductContent client:idle serverProduct={product} serverSimilarItems={similarItems} />
</Layout>
