{
  "name": "ce-starter-projects",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:linea": "turbo run dev --filter=@ce/linea",
    "dev:linea-ssr": "turbo run dev --filter=@ce/linea-ssr",
    "build:linea": "turbo run build --filter=@ce/linea",
    "build:linea-ssr": "turbo run build --filter=@ce/linea-ssr",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "turbo": "latest"
  }
}