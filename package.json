{
  "name": "ce-starter-projects",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:linea": "turbo run dev --filter=@ce/linea",
    "dev:linea-tanstack": "turbo run dev --filter=@ce/linea-tanstack",
    "dev:linea-next": "turbo run dev --filter=@ce/linea-next",
    "dev:linea-astro": "turbo run dev --filter=@ce/linea-astro",
    "dev:linea-svelte": "turbo run dev --filter=@ce/linea-svelte",
    "dev:little-things": "turbo run dev --filter=@ce/little-things",
    "dev:little-things-next": "turbo run dev --filter=@ce/little-things-next",
    "dev:little-things-tanstack": "turbo run dev --filter=@ce/little-things-tanstack",
    "dev:little-things-astro": "turbo run dev --filter=@ce/little-things-astro",
    "dev:little-things-svelte": "turbo run dev --filter=@ce/little-things-svelte",
    "build:linea": "turbo run build --filter=@ce/linea",
    "build:linea-tanstack": "turbo run build --filter=@ce/linea-tanstack",
    "build:linea-next": "turbo run build --filter=@ce/linea-next",
    "build:linea-astro": "turbo run build --filter=@ce/linea-astro",
    "build:linea-svelte": "turbo run build --filter=@ce/linea-svelte",
    "build:little-things": "turbo run build --filter=@ce/little-things",
    "build:little-things-next": "turbo run build --filter=@ce/little-things-next",
    "build:little-things-tanstack": "turbo run build --filter=@ce/little-things-tanstack",
    "build:little-things-astro": "turbo run build --filter=@ce/little-things-astro",
    "build:little-things-svelte": "turbo run build --filter=@ce/little-things-svelte",
    "build:all": "turbo run build --filter=@ce/linea --filter=@ce/linea-tanstack --filter=@ce/linea-next --filter=@ce/linea-astro --filter=@ce/linea-svelte --filter=@ce/little-things --filter=@ce/little-things-next --filter=@ce/little-things-tanstack --filter=@ce/little-things-astro --filter=@ce/little-things-svelte",
    "preview:linea": "turbo run preview --filter=@ce/linea",
    "preview:linea-tanstack": "turbo run preview --filter=@ce/linea-tanstack",
    "preview:linea-next": "turbo run preview --filter=@ce/linea-next",
    "preview:linea-astro": "turbo run preview --filter=@ce/linea-astro",
    "preview:linea-svelte": "turbo run preview --filter=@ce/linea-svelte",
    "preview:little-things": "turbo run preview --filter=@ce/little-things",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,svelte,json,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{ts,tsx}": "bash -c 'bunx turbo run typecheck'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.8.20"
  }
}