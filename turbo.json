{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "inputs": [
        "src/**",
        "index.html",
        "vite.config.ts",
        "tsconfig.json",
        "tsconfig.app.json",
        "postcss.config.js"
      ],
      "env": ["VITE_STORE_ID", "VITE_API_KEY", "VITE_CE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "check:fix": {
      "cache": false
    },
    "typecheck": {
      "outputs": []
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
