{
  "name": "ce-starter-projects",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:linea": "turbo run dev --filter=@ce/linea",
    "dev:linea-ssr": "turbo run dev --filter=@ce/linea-ssr",
    "dev:linea-next": "turbo run dev --filter=@ce/linea-next",
    "build:linea": "turbo run build --filter=@ce/linea",
    "build:linea-ssr": "turbo run build --filter=@ce/linea-ssr",
    "build:linea-next": "turbo run build --filter=@ce/linea-next",
    "build:all": "turbo run build --filter=@ce/linea --filter=@ce/linea-ssr --filter=@ce/linea-next",
    "preview:linea-next": "turbo run preview --filter=@ce/linea-next",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,md}": [
      "biome format --write --no-errors-on-unmatched",
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{ts,tsx}": "bash -c 'bunx turbo run typecheck'"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "turbo": "latest"
  }
}